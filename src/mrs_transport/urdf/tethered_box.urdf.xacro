<?xml version="1.0"?>
<robot name="mrs_system" xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="common_box">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry><box size="0.5 0.5 0.5"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.5 0.5 0.5"/></geometry>
    </collision>
  </link>
  <gazebo reference="common_box"><material>Gazebo/Blue</material></gazebo>

  <xacro:macro name="tethered_burger" params="prefix x y yaw color">
    <link name="tb3_${prefix}_link">
      <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://turtlebot3_description/meshes/bases/burger_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry><cylinder length="0.15" radius="0.12"/></geometry>
      </collision>
    </link>

    <joint name="spring_joint_${prefix}" type="prismatic">
      <parent link="common_box"/>
      <child link="tb3_${prefix}_link"/>
      <origin xyz="${x} ${y} -0.22" rpy="0 0 ${yaw}"/> 
      <axis xyz="1 0 0"/>
      <limit lower="-1.0" upper="1.0" effort="100" velocity="10"/>
      <dynamics damping="5.0" friction="0.0" stiffness="150.0"/>
    </joint>

    <gazebo reference="spring_joint_${prefix}">
      <provideFeedback>true</provideFeedback>
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>

    <gazebo reference="tb3_${prefix}_link"><material>Gazebo/${color}</material></gazebo>

    <gazebo>
      <plugin name="move_${prefix}" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/tb3_${prefix}</namespace></ros>
        <robot_base_frame>tb3_${prefix}_link</robot_base_frame>
      </plugin>
      <plugin name="ft_${prefix}" filename="libgazebo_ros_ft_sensor.so">
        <ros><namespace>/tb3_${prefix}</namespace><remapping>wrench:=force_sensor</remapping></ros>
        <joint_name>spring_joint_${prefix}</joint_name>
        <update_rate>50.0</update_rate>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:tethered_burger prefix="leader" x="0.4" y="0"     yaw="0"      color="Red"/>
  <xacro:tethered_burger prefix="f1"     x="0"   y="0.4"   yaw="1.5708" color="Green"/>
  <xacro:tethered_burger prefix="f2"     x="0"   y="-0.4"  yaw="-1.5708" color="Yellow"/>

</robot>